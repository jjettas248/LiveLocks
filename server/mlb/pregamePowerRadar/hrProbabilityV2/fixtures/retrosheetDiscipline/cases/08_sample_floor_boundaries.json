    "batterOverall": [
      {"batterId": "bpa149", "pa": 149, "pitchSequenceCoverage": 0.98, "batterRatesPresent": false, "nullReason": "below_batter_pa_floor", "rawCountsPreserved": true},
      {"batterId": "bpa151", "pa": 151, "pitchSequenceCoverage": 0.98, "batterRatesPresent": true, "nullReason": null}
    ],
    "pitcherOverall": [
      {"pitcherId": "pbf299", "bf": 299, "pitchSequenceCoverage": 0.98, "pitcherRatesPresent": false, "nullReason": "below_pitcher_bf_floor", "rawCountsPreserved": true},
      {"pitcherId": "pbf301", "bf": 301, "pitchSequenceCoverage": 0.98, "pitcherRatesPresent": true, "nullReason": null}
    ],
    "batterHandSplit": [
      {"batterId": "bsplit", "paVsL": 74, "paVsR": 76, "vsLPresent": false, "vsLNullReason": "below_hand_split_pa_floor", "vsRPresent": true, "vsRNullReason": null,
       "note": "Only the below-floor split nulls; the other split and the overall are unaffected."}
    ],
    "pitcherHandSplit": [
      {"pitcherId": "psplit", "bfVsL": 149, "bfVsR": 151, "vsLPresent": false, "vsLNullReason": "below_hand_split_bf_floor", "vsRPresent": true, "vsRNullReason": null}
    ]
  }
